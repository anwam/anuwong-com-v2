---
import FormattedDate from "@/components/FormattedDate.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  posts: CollectionEntry<"blog">[];
};

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <>
      <div class="flex items-center gap-x-2">
        <h2 class="w-fit text-xl font-bold text-gray-800">Blogs</h2>
        <a class="text-xs text-gray-600 underline" href="/blogs">
          <span>ดูทั้งหมด</span>
        </a>
      </div>
      <ul class="grid grid-flow-row gap-3 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <li class="overflow-hidden rounded-lg bg-gray-50 transition-all hover:shadow hover:shadow-gray-300 dark:border dark:border-gray-800/80 dark:bg-gray-900/40 dark:hover:shadow-none">
            <a
              class="flex h-full flex-row items-center gap-4 p-4"
              href={`/blogs/${post.id}`}
            >
              {post.data.preview && (
                <Image
                  src={post.data.preview}
                  width={192}
                  height={192}
                  class="aspect-square h-16 w-16 rounded-lg border border-gray-300 bg-gray-50 object-contain p-1"
                  alt={`preview of ${post.id}`}
                />
              )}

              <div class="flex min-w-0 flex-col gap-1">
                <h3 class="line-clamp-2 font-semibold text-gray-900 dark:text-gray-100">
                  {post.data.title}
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  <FormattedDate date={post.data.date} />
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </>
  )
}
