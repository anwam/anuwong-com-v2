---
import { Image } from "astro:assets";
import ProfileImage from "@/assets/images/profile.jpg";
---

<h2 class="sr-only">Profile</h2>
<section class="">
  <div class="flex w-full flex-col items-center gap-y-2 md:flex-row md:gap-x-4">
    <Image
      src={ProfileImage}
      width={128 * 2}
      height={128 * 2}
      class="h-32 w-32 rounded-full"
      alt="Anuwong Mongkudkornburee"
    />
    <section
      class="w-full rounded bg-gray-100 p-2 transition-colors duration-300 dark:border dark:border-gray-800/80 dark:bg-gray-900/60"
    >
      <p
        class="mb-2 font-sans text-sm font-bold text-gray-900 md:text-lg dark:text-gray-100"
      >
        Anuwong (Bill) Mongkudkornburee
      </p>
      <p class="font-sans text-sm text-gray-600 dark:text-gray-400">
        Software Engineer at
        <a
          class="font-bold text-cyan-600 underline dark:text-cyan-400"
          target="_blank"
          href="https://www.kbtg.tech">KBTG</a
        >
      </p>
      <p class="text-sm text-pretty text-gray-700 dark:text-gray-300">
        Fullstack developer proficient in Nodejs, React, and Golang
      </p>
      <h3 class="sr-only">Contact</h3>
      <div
        class="mt-2 flex items-center gap-x-2 text-gray-800 dark:text-gray-200"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
          ></path>
        </svg>
        <p class="text-gray-800 dark:text-gray-200">dev.anuwong@gmail.com</p>
      </div>
    </section>
  </div>
</section>
