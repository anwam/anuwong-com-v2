---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;

const { pathname } = Astro.url;

const slashes = pathname.replace(/\/$/, "").split("/");
const isActive =
  href === pathname ||
  href === pathname.replace(/\/$/, "") ||
  (href?.toString() &&
    slashes
      .slice(1, slashes.length)
      .includes(href?.toString()?.replace(/^\//, "")));
---

<a
  href={href}
  class:list={[
    className,
    "font-bold text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-100",
    "px-4 py-2",
    "inline-block border-b-4 border-transparent transition-colors",
    "hover:border-gray-500 dark:hover:border-gray-400",
    { "border-gray-800 dark:border-gray-100": isActive },
  ]}
  {...props}
>
  <slot />
</a>
