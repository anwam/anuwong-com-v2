---
import Analytics from "@/components/Analytics.astro";
import "@fontsource/ibm-plex-sans-thai/400.css";
import "@fontsource/ibm-plex-sans-thai/700.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-700.css";
import "@fontsource/sarabun/thai-400.css";
import "@fontsource/sarabun/thai-700.css";
import { ClientRouter } from "astro:transitions";
import themeScript from "@/modules/theme/theme.ts?raw";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  imageUrl?: string;
  ogType?: "website" | "article";
}

const { title, description, imageUrl, ogType } = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <BaseHead
      title={title}
      description={description}
      imageUrl={imageUrl}
      ogType={ogType}
    />
    <script is:inline set:html={themeScript} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body
    class="bg-gray-300 text-gray-900 transition-colors duration-300 dark:bg-gray-950 dark:text-gray-100"
  >
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <slot name="scripts" />

    <!-- Google Tag Manager -->
    {import.meta.env.PROD && <Analytics />}
  </body>
</html>
