---
import { getBlogCatalog } from "@/modules/blog/getBlogCatalog";
import type { CollectionEntry } from "astro:content";
import BlogItem from "@/modules/blog/components/BlogItem.astro";
import { SITE_TITLE } from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const { tags } = await getBlogCatalog();
  return tags.map(({ name, posts }) => ({
    params: { tag: name },
    props: { posts },
  }));
}

const { tag } = Astro.params;
type Props = { posts: CollectionEntry<"blog">[] };
const { posts } = Astro.props;

const title = `Tag: ${tag} | ${SITE_TITLE}`;
const description = `All blog posts tagged with "${tag}"`;
---

<BaseLayout title={title} description={description}>
  <main class="container mx-auto mt-3 px-3 md:mt-4 md:px-0 lg:max-w-5xl">
    <header
      class="mb-6 rounded-2xl border border-gray-300/60 bg-linear-to-br from-gray-100 via-gray-50 to-gray-200/60 p-5 shadow-sm transition-colors duration-300 md:p-7 dark:border-gray-800/80 dark:from-gray-900/80 dark:via-gray-900/50 dark:to-gray-800/40"
    >
      <a
        href="/tags"
        class="inline-flex items-center gap-2 text-sm font-medium text-gray-700 transition-colors hover:text-gray-900 focus-visible:ring-2 focus-visible:ring-cyan-500/70 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-100 focus-visible:outline-none dark:text-gray-300 dark:hover:text-gray-100 dark:focus-visible:ring-offset-gray-950"
      >
        ← All tags
      </a>
      <h1
        class="mt-3 text-3xl font-bold text-gray-900 md:text-4xl dark:text-gray-100"
      >
        <span class="text-gray-600 dark:text-cyan-400">#{tag}</span>
      </h1>
      <p class="mt-2 text-gray-700 dark:text-gray-300">
        {posts.length}
        {posts.length === 1 ? "post" : "posts"} in this tag
      </p>
    </header>

    {
      posts.length > 0 ? (
        <section class="grid grid-cols-1 grid-rows-[repeat(4,auto)] gap-4 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, index) => (
            <BlogItem isFirst={index === 0} post={post} />
          ))}
        </section>
      ) : (
        <div class="rounded-2xl border border-gray-300/60 bg-gray-100/80 p-8 text-center shadow-sm transition-colors duration-300 dark:border-gray-800/80 dark:bg-gray-900/40">
          <p class="text-gray-700 dark:text-gray-300">
            No posts found with this tag.
          </p>
          <a
            href="/tags"
            class="mt-4 inline-flex items-center rounded-full bg-gray-900 px-4 py-2 text-sm font-semibold text-gray-100 transition-colors hover:bg-gray-700 focus-visible:ring-2 focus-visible:ring-cyan-500/70 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-100 focus-visible:outline-none dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-gray-300 dark:focus-visible:ring-offset-gray-950"
          >
            Browse other tags
          </a>
        </div>
      )
    }
  </main>
</BaseLayout>
